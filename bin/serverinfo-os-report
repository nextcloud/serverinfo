#!/bin/sh
# SPDX-FileCopyrightText: 2026 Nextcloud GmbH and Nextcloud contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# serverinfo-os-report: optional root helper for the Nextcloud Monitoring app.
#
# The Monitoring app runs as the web server user, which can see most of the
# operating system status by itself. This helper adds what only root can see:
#
#   - services still running code that an upgrade replaced (needrestart,
#     dnf needs-restarting, zypper ps, or a scan of /proc as a fallback)
#   - fresh package lists (--refresh), so pending updates are current
#   - pending dnf updates, which dnf 5 does not tell other users
#   - SUSE LTSS registration
#
# It only reads the system and writes one JSON file. It never installs,
# upgrades, restarts or reboots anything.
#
# Install it outside the Nextcloud directory, which the web server can write
# to, so that the web server cannot change what root runs later on. Take the
# file from a freshly extracted release archive, not from the installed
# app: the Nextcloud server archive, checked against the SHA-256 sum or
# signature published next to it on download.nextcloud.com, or the app's
# own release archive. A copy taken from apps/serverinfo/bin is safe from
# changes made after copying, but not from a web server that was already
# compromised and changed the file before. If both copies are at hand,
# `cmp` shows whether the installed app's file still matches the release.
# Repeat this when an update ships a newer helper. Extract the file into a
# new directory that only you can enter, which `mktemp -d` creates, so that
# no one can swap it before root installs it. Remove that directory
# afterwards.
#
#   d=$(mktemp -d) &&
#   tar -xjf nextcloud-<version>.tar.bz2 -C "$d" nextcloud/apps/serverinfo/bin/serverinfo-os-report &&
#   sudo install -o root -g root -m 0755 "$d"/nextcloud/apps/serverinfo/bin/serverinfo-os-report /usr/local/sbin/ &&
#   rm -r "$d"
#   echo '17 */6 * * * root /usr/local/sbin/serverinfo-os-report --refresh --random-delay' | sudo tee /etc/cron.d/serverinfo-os-report
#
# Report format (schema 1), all fields but the first five optional:
#   schema, helperVersion, generatedAt (unix time), hostname, bootTime (unix time),
#   distribution, listsRefreshedAt (unix time, after a successful --refresh),
#   pendingUpdates (list of {name, installed, candidate, security, origin,
#   advisories, severity}, null when not collected),
#   restartServices (list of systemd units, null when unknown),
#   rebootReasons (list of {kind: kernel|microcode, detail}),
#   subscription ({kind, active}), errors (list of strings)

set -u
# Command output is split into words in places; it must never be expanded as
# a file name pattern.
set -f
umask 022

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
LANG=C
export PATH LC_ALL LANG

VERSION=1.0.0
SCHEMA=1
OUTPUT=/var/lib/serverinfo/os-report.json
LOCK=/run/serverinfo-os-report.lock
REFRESH=0
RANDOM_DELAY=0
DRY_RUN=0
TEMPORARY=
TIMEOUT_MODE=
ERRORS=
SERVICES=
REBOOT_REASONS=

usage() {
	cat <<EOF
Usage: serverinfo-os-report [--refresh] [--random-delay] [--output FILE] [--dry-run]

Writes the operating system report the Nextcloud Monitoring app reads.

  --refresh      refresh the package lists first (apt-get update, dnf makecache, ...)
  --random-delay wait up to 30 minutes first, so that servers sharing a cron
                 schedule do not all reach the mirrors at once
  --output FILE  where to write the report (default: $OUTPUT)
  --dry-run      print the report instead of writing it
  --version      print the version and exit
  --help         show this help
EOF
}

die() {
	printf 'serverinfo-os-report: %s\n' "$1" >&2
	exit 1
}

# Records a problem for the report. Only printable ASCII is kept, so the
# message can be placed in JSON after escaping quotes and backslashes.
note_error() {
	message=$(printf '%s' "$1" | tr -c '\040-\176' ' ' | cut -c1-300)
	ERRORS="$ERRORS$message
"
}

json_text() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# Package, unit and version tokens are emitted only when they consist of
# characters that need no escaping in JSON; anything else is dropped.
is_token() {
	case "$1" in
		'' | *[!A-Za-z0-9@._+:~^-]*) return 1 ;;
		*) return 0 ;;
	esac
}

# Removes the temporary report, if there is one.
cleanup() {
	if [ -n "$TEMPORARY" ]; then
		rm -f "$TEMPORARY"
		TEMPORARY=
	fi
}

# Cleans up on every exit; a signal ends the run with an error.
set_traps() {
	trap cleanup EXIT
	trap 'cleanup; exit 1' HUP INT TERM
}

# How run_limited can stop a command: "kill" when timeout(1) takes -k,
# "term" when it only sends SIGTERM, "none" without timeout(1) or with the
# busybox before 1.30, which has another syntax.
timeout_mode() {
	if ! command -v timeout >/dev/null 2>&1; then
		echo none
	elif timeout -k 1 10 true >/dev/null 2>&1; then
		echo kill
	elif timeout 10 true >/dev/null 2>&1; then
		echo term
	else
		echo none
	fi
}

# Runs a command ($2 ...) for at most $1 seconds, and kills it 30 seconds
# after that if it ignores SIGTERM. The lock is not passed on, so nothing
# the command leaves running can hold it.
run_limited() {
	limit=$1
	shift
	[ -n "$TIMEOUT_MODE" ] || TIMEOUT_MODE=$(timeout_mode)
	case "$TIMEOUT_MODE" in
		kill) timeout -k 30 "$limit" "$@" 9>&- ;;
		term) timeout "$limit" "$@" 9>&- ;;
		*) "$@" 9>&- ;;
	esac
}

# Exits quietly when another run holds the lock. Without flock(1), as in
# some busybox builds, runs are not locked; each still writes its own
# temporary file and renames it into place.
take_lock() {
	command -v flock >/dev/null 2>&1 || return 0
	[ -d "$(dirname "$LOCK")" ] || return 0
	exec 9>>"$LOCK"
	if ! flock -n 9; then
		[ -t 2 ] && printf 'serverinfo-os-report: another run is still going\n' >&2
		exit 0
	fi
}

# Waits a random time of up to 30 minutes; does not wait without a source
# of random numbers.
random_delay() {
	number=$(od -An -N2 -tu2 /dev/urandom 2>/dev/null | tr -d ' \n')
	case "$number" in
		'' | *[!0-9]*) return 0 ;;
	esac
	sleep $((number % 1800))
}

os_value() {
	sed -n "s/^$1=//p" /etc/os-release 2>/dev/null | head -n 1 | tr -d "\"'"
}

add_service() {
	unit=$1
	case "$unit" in
		*.service) ;;
		*) unit="$unit.service" ;;
	esac
	is_token "$unit" || return 0
	case "
$SERVICES" in
		*"
$unit
"*) return 0 ;;
	esac
	SERVICES="$SERVICES$unit
"
}

# One unit per line.
add_services() {
	while IFS= read -r unit; do
		unit=$(printf '%s' "$unit" | tr -d ' \t\r')
		[ -n "$unit" ] && add_service "$unit"
	done <<EOF
$1
EOF
}

add_reboot_reason() {
	kind=$1
	detail=$2
	if is_token "$detail"; then
		item="{\"kind\":\"$kind\",\"detail\":\"$detail\"}"
	else
		item="{\"kind\":\"$kind\",\"detail\":null}"
	fi
	REBOOT_REASONS="${REBOOT_REASONS:+$REBOOT_REASONS,}$item"
}

# The configuration needrestart runs with, as Perl it evaluates: the system
# configuration, then no interpreter scan. That scan runs interpreters with
# settings taken from the processes it inspects, which their owners control
# (CVE-2024-48990, CVE-2024-48992 and others), so root must not run it on a
# schedule. Options given on the command line (-b, -r l) take precedence.
# shellcheck disable=SC2016
NEEDRESTART_CONFIG='if (-r q(/etc/needrestart/needrestart.conf)) {
	eval do { local $/; open my $fh, q(<), q(/etc/needrestart/needrestart.conf) or die "ERROR: $!\n"; <$fh> };
	die $@ if $@;
}
$nrconf{interpscan} = 0;
$nrconf{sendnotify} = 0;'

# The configuration reaches needrestart through a pipe, so there is no file
# anyone could change between writing and reading it. If needrestart cannot
# read or evaluate it, it exits with an error instead of using its defaults.
from_needrestart() {
	command -v needrestart >/dev/null 2>&1 || return 1
	output=$(printf '%s\n' "$NEEDRESTART_CONFIG" | run_limited 300 needrestart -c /dev/stdin -b -r l 2>/dev/null) || return 1
	parse_needrestart "$output"
}

# Takes services and reboot reasons from needrestart's batch output ($1).
parse_needrestart() {
	printf '%s\n' "$1" | grep -q '^NEEDRESTART-VER:' || return 1

	add_services "$(printf '%s\n' "$1" | sed -n 's/^NEEDRESTART-SVC: *//p')"

	kernel_status=$(printf '%s\n' "$1" | sed -n 's/^NEEDRESTART-KSTA: *//p')
	expected=$(printf '%s\n' "$1" | sed -n 's/^NEEDRESTART-KEXP: *//p')
	case "$kernel_status" in
		2 | 3) add_reboot_reason kernel "$expected" ;;
	esac
	microcode_status=$(printf '%s\n' "$1" | sed -n 's/^NEEDRESTART-UCSTA: *//p')
	[ "$microcode_status" = 2 ] && add_reboot_reason microcode ''
	return 0
}

from_dnf() {
	command -v dnf >/dev/null 2>&1 || return 1
	# dnf 5 loads the repositories for needs-restarting; --cacheonly keeps it
	# from downloading metadata. dnf 4 accepts the option and loads none.
	output=$(run_limited 300 dnf -q --cacheonly needs-restarting -s 2>/dev/null) || return 1
	add_services "$output"
	return 0
}

from_zypper() {
	command -v zypper >/dev/null 2>&1 || return 1
	# Exits 4 without lsof; the /proc scan then answers instead.
	output=$(run_limited 300 zypper --non-interactive --quiet ps -sss 2>/dev/null) || return 1
	add_services "$output"
	return 0
}

# Fallback for any systemd distribution: processes that map a library which
# has been deleted since, attributed to their systemd unit.
from_proc() {
	[ -d /proc/1 ] || return 1
	set +f
	directories=$(printf '%s\n' /proc/[0-9]*)
	set -f
	for dir in $directories; do
		[ -r "$dir/maps" ] || continue
		awk '
			/ \(deleted\)$/ && $6 ~ /\.so/ && $6 !~ /^\/(dev|memfd:|tmp|var\/tmp|run|proc|SYSV)/ { found = 1; exit }
			END { exit found ? 0 : 1 }
		' "$dir/maps" 2>/dev/null || continue
		unit=$(system_unit "$dir/cgroup")
		[ -n "$unit" ] && add_service "$unit"
	done
	return 0
}

# Prints the system service a process belongs to, from its cgroup file
# ($1): cgroup v2 (0::/system.slice/...) or the systemd hierarchy of v1.
# Units under user.slice are users' own and are left out.
system_unit() {
	sed -n \
		-e 's#^0::/system\.slice/\(.*/\)\{0,1\}\([^/]*\.service\)$#\2#p' \
		-e 's#^[0-9]*:name=systemd:/system\.slice/\(.*/\)\{0,1\}\([^/]*\.service\)$#\2#p' \
		"$1" 2>/dev/null | head -n 1
}

# Prints pending dnf updates as a JSON list, from the output of
# `dnf check-update` ($1), the security advisory list of dnf 4 or 5 ($2) and
# `rpm -qa` with name and epoch:version-release ($3). Values that are not
# plain tokens are dropped, so nothing needs escaping.
dnf_updates_json() {
	{
		printf '%s\n' "$3" | sed 's/^/I /'
		printf '%s\n' "$2" | sed 's/^/A /'
		printf '%s\n' "$1" | sed 's/^/U /'
	} | awk '
		function token(s) { return s ~ /^[A-Za-z0-9@._+:~^-]+$/ }
		# The architecture is whatever follows the last dot: x86_64, x86_64_v2, noarch, s390, ...
		function strip_arch(s) { sub(/\.[A-Za-z0-9_]+$/, "", s); return s }
		function rank(s) {
			s = tolower(s)
			return s == "critical" ? 4 : s == "important" ? 3 : s == "moderate" ? 2 : s == "low" ? 1 : 0
		}
		$1 == "I" && NF == 3 && token($3) { version = $3; sub(/^0:/, "", version); installed[$2] = version; next }
		$1 == "A" {
			if ($3 ~ /\/Sec\.$/) { severity = $3; sub(/\/Sec\.$/, "", severity); nevra = $4 }
			else if ($3 == "security") { severity = $4; nevra = $5 }
			else next
			if (!token($2) || !token(nevra)) next
			name = strip_arch(nevra)
			sub(/-[^-]+-[^-]+$/, "", name)
			if (!((name, $2) in seen)) {
				seen[name, $2] = 1
				ids[name] = ids[name] (ids[name] == "" ? "" : ",") "\"" $2 "\""
			}
			if (severity ~ /^[A-Za-z]+$/ && rank(severity) > rank(highest[name])) highest[name] = severity
			next
		}
		$1 == "U" && $2 ~ /^Obsoleting/ { stop = 1 }
		# dnf 4 continues a row on the next line, indented to the next column,
		# after a name or version too wide for its column.
		$1 == "U" && !stop && held != "" {
			if ($0 ~ /^U [ \t]/) $0 = "U " held " " substr($0, 3)
			held = ""
		}
		$1 == "U" && !stop && (NF == 2 || NF == 3) && $0 !~ /^U [ \t]/ && $2 ~ /\.[A-Za-z0-9_]+$/ {
			held = substr($0, 3)
			next
		}
		$1 == "U" && !stop && NF == 4 && $2 ~ /\.[A-Za-z0-9_]+$/ {
			if (!token($2) || !token($3) || !token($4)) next
			name = strip_arch($2)
			out = out (count++ ? "," : "") sprintf("{\"name\":\"%s\",\"installed\":%s,\"candidate\":\"%s\",\"security\":%s,\"origin\":\"%s\",\"advisories\":[%s],\"severity\":%s}",
				name,
				(name in installed) ? "\"" installed[name] "\"" : "null",
				$3,
				(name in ids) ? "true" : "false",
				$4,
				ids[name],
				(name in highest) ? "\"" highest[name] "\"" : "null")
		}
		END { printf "[%s]", out }
	'
}

dnf_pending_updates() {
	command -v dnf >/dev/null 2>&1 || return 1
	updates=$(run_limited 600 dnf -q --cacheonly check-update 2>/dev/null)
	case $? in
		0) printf '[]'; return 0 ;;
		100) ;;
		*) return 1 ;;
	esac
	if command -v dnf5 >/dev/null 2>&1; then
		advisories=$(run_limited 600 dnf -q --cacheonly advisory list --security 2>/dev/null) || return 1
	else
		advisories=$(run_limited 600 dnf -q --cacheonly updateinfo list --security --available 2>/dev/null) || return 1
	fi
	installed=$(rpm -qa --qf '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE}\n' 2>/dev/null) || return 1
	dnf_updates_json "$updates" "$advisories" "$installed"
}

main() {
	while [ $# -gt 0 ]; do
		case "$1" in
			--refresh) REFRESH=1 ;;
			--random-delay) RANDOM_DELAY=1 ;;
			--dry-run) DRY_RUN=1 ;;
			--output)
				[ $# -ge 2 ] || die '--output needs a file name'
				OUTPUT=$2
				shift
				;;
			--output=*) OUTPUT=${1#--output=} ;;
			--version) echo "$VERSION"; exit 0 ;;
			--help | -h) usage; exit 0 ;;
			*) usage >&2; exit 1 ;;
		esac
		shift
	done

	case "$OUTPUT" in
		/*.json) ;;
		*) die 'the output must be an absolute path ending in .json' ;;
	esac
	case "$OUTPUT" in
		*/../* | */./* | *[!A-Za-z0-9._/-]*) die 'the output path may only contain letters, digits, dots, dashes, underscores and slashes' ;;
	esac

	[ "$(id -u)" -eq 0 ] || die 'must run as root'
	cd / || exit 1

	set_traps
	[ "$RANDOM_DELAY" -eq 1 ] && random_delay
	take_lock
	TIMEOUT_MODE=$(timeout_mode)

	# --- identity -----------------------------------------------------------

	HOSTNAME_VALUE=$(hostname 2>/dev/null || cat /proc/sys/kernel/hostname 2>/dev/null)
	is_token "$HOSTNAME_VALUE" || die 'the host name could not be determined'

	BOOT_TIME=$(awk '/^btime / { print $2 }' /proc/stat 2>/dev/null)
	case "$BOOT_TIME" in
		'' | *[!0-9]*) BOOT_TIME=null ;;
	esac

	DISTRO_ID=$(os_value ID)
	DISTRO_LIKE=$(os_value ID_LIKE)
	is_token "$DISTRO_ID" || DISTRO_ID=unknown

	case " $DISTRO_ID $DISTRO_LIKE " in
		*' debian '* | *' ubuntu '*) FAMILY=apt ;;
		*' suse '* | *' opensuse'* | *' sles '*) FAMILY=zypper ;;
		*' fedora '* | *' rhel '* | *' centos '* | *' amzn '*) FAMILY=dnf ;;
		*' arch '*) FAMILY=pacman ;;
		*' alpine '*) FAMILY=apk ;;
		*) FAMILY=unknown ;;
	esac

	# --- package lists ------------------------------------------------------

	LISTS_REFRESHED_AT=null
	if [ "$REFRESH" -eq 1 ]; then
		refreshed=0
		case "$FAMILY" in
			apt) run_limited 900 apt-get update -qq -o DPkg::Lock::Timeout=300 >/dev/null 2>&1 && refreshed=1 ;;
			dnf) run_limited 900 dnf -q makecache >/dev/null 2>&1 && refreshed=1 ;;
			zypper) run_limited 900 zypper --non-interactive --quiet refresh >/dev/null 2>&1 && refreshed=1 ;;
			apk) run_limited 900 apk update -q >/dev/null 2>&1 && refreshed=1 ;;
			# pacman -Sy without -u leaves Arch half upgraded; checkupdates, which
			# the app runs itself, syncs into a private database instead.
			*) refreshed=2 ;;
		esac
		case "$refreshed" in
			1) LISTS_REFRESHED_AT=$(date +%s) ;;
			0) note_error "Refreshing the package lists with $FAMILY failed." ;;
		esac
	fi

	PENDING=null
	if [ "$FAMILY" = dnf ]; then
		PENDING=$(dnf_pending_updates) || {
			PENDING=null
			note_error 'Pending updates could not be listed with dnf.'
		}
	fi

	# --- services that need a restart ---------------------------------------

	services_known=0
	case "$FAMILY" in
		apt) from_needrestart && services_known=1 ;;
		dnf) from_dnf && services_known=1 ;;
		zypper) from_zypper && services_known=1 ;;
	esac
	if [ "$services_known" -eq 0 ]; then
		from_proc && services_known=1
	fi
	[ "$services_known" -eq 1 ] || note_error 'Services that need a restart could not be determined.'

	# --- subscriptions ------------------------------------------------------

	SUBSCRIPTION=null
	if [ "$FAMILY" = zypper ] && command -v SUSEConnect >/dev/null 2>&1; then
		status=$(run_limited 120 SUSEConnect --status 2>/dev/null | tr -d ' \n')
		case "$status" in
			*'"identifier":"SLES-LTSS"'*'"status":"Registered"'*) SUBSCRIPTION='{"kind":"suse-ltss","active":true}' ;;
			'['*) SUBSCRIPTION='{"kind":"suse-ltss","active":false}' ;;
		esac
	fi

	# --- report -------------------------------------------------------------

	services_json=null
	if [ "$services_known" -eq 1 ]; then
		services_json=$(printf '%s' "$SERVICES" | awk 'NF { printf "%s\"%s\"", (n++ ? "," : ""), $0 }')
		services_json="[$services_json]"
	fi

	errors_json=
	old_ifs=$IFS
	IFS='
'
	for message in $ERRORS; do
		errors_json="${errors_json:+$errors_json,}$(json_text "$message")"
	done
	IFS=$old_ifs

	REPORT=$(cat <<EOF
{
  "schema": $SCHEMA,
  "helperVersion": "$VERSION",
  "generatedAt": $(date +%s),
  "hostname": "$HOSTNAME_VALUE",
  "bootTime": $BOOT_TIME,
  "distribution": "$DISTRO_ID",
  "listsRefreshedAt": $LISTS_REFRESHED_AT,
  "pendingUpdates": $PENDING,
  "restartServices": $services_json,
  "rebootReasons": [$REBOOT_REASONS],
  "subscription": $SUBSCRIPTION,
  "errors": [$errors_json]
}
EOF
)

	if [ "$DRY_RUN" -eq 1 ]; then
		printf '%s\n' "$REPORT"
		exit 0
	fi

	write_report "$REPORT" "$OUTPUT"
}

# Creates the report's directory ($1) if needed and makes sure it and its
# parent are root's alone: anyone who can write to them could swap the
# report, or plant a symlink for root to write through.
secure_directory() {
	[ -L "$1" ] && die "$1 is a symbolic link"
	if [ ! -d "$1" ]; then
		# Parent directories get 0755 from the umask set above.
		# shellcheck disable=SC2174
		mkdir -p -m 0755 "$1" || die "cannot create $1"
	fi
	for path in "$1" "$(dirname "$1")"; do
		[ "$(stat -c %u "$path")" = 0 ] || die "$path must be owned by root"
		case "$(stat -c %a "$path")" in
			*[2367]? | *[2367]) die "$path must not be writable by group or others" ;;
		esac
	done
}

# Replaces the report file ($2) with the report ($1) in one step.
write_report() {
	directory=$(dirname "$2")
	secure_directory "$directory"
	# mv would move the report into a directory of that name, or into the
	# one a symbolic link of that name points to.
	[ -d "$2" ] && die "$2 is a directory"

	TEMPORARY=$(mktemp "$directory/.os-report.XXXXXX") || die "cannot write to $directory"
	printf '%s\n' "$1" > "$TEMPORARY" || die "cannot write $TEMPORARY"
	chmod 0644 "$TEMPORARY"
	# rename(2) replaces a symbolic link to a file instead of following it.
	mv -f "$TEMPORARY" "$2" || die "cannot replace $2"
	TEMPORARY=
}

# Tests load the functions above without running anything.
if [ "${SERVERINFO_OS_REPORT_FUNCTIONS_ONLY:-}" != 1 ]; then
	main "$@"
fi
